#!/bin/sh
# The login window runs a zacos9-wm as greetd's own user, and seatd hands
# the screen only to the video group (seatd -g video), so without it the
# window never gets the seat: Log Out left a frozen screen. Render is for
# the GPU's render node, as the Setup Assistant's account has.
set -e

greeter_seat() {
	getent passwd _greetd >/dev/null 2>&1 || return 0
	for g in video render; do
		getent group "$g" >/dev/null 2>&1 || continue
		usermod -aG "$g" _greetd ||
			echo "zacos9: could not add the login window to the $g group;" \
				"Log Out may leave a blank screen." >&2
	done
}

case "$1" in
	configure)
		greeter_seat
		;;
esac

#DEBHELPER#

exit 0
