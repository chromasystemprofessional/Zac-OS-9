#!/bin/sh
# The full ZacOS system: boot, installer, Setup Assistant, Software/Update
# and the update timer. The desktop itself is zacos9-session, and the login
# window is zacos9-greeter.
set -e

# GRUB's start-up picture (/etc/grub.d/09_zacos9) is drawn once by
# zacos9-install for the screen's size; draw it again at that size so an
# upgrade's new boot art shows from the first moment, not only from the
# splash on. Same file name, so GRUB's config needs no update.
redraw_grub_logo() {
	[ -f /boot/grub/zacos9-logo.png ] || return 0
	/usr/libexec/zacos9/zacos9-bootlogo --redraw /boot/grub/zacos9-logo.png ||
		echo "zacos9: could not redraw the start-up picture." >&2
}

# The Monitors panel's machine-wide rotation (zacos9-accounts-helper
# display) also turns the kernel console and the boot splash; the helper
# rewrites GRUB_CMDLINE_LINUX and runs update-grub. Best-effort: on a
# machine without GRUB, or in a chroot, it only warns.
rotate_boot() {
	[ -f /etc/zacos9/desktop.conf ] || return 0
	[ -x /usr/libexec/zacos9/zacos9-rotate-boot ] || return 0
	/usr/libexec/zacos9/zacos9-rotate-boot || true
}

# Shared Documents (Mac OS 9's Multiple Users): one folder everyone on the
# computer can put things in, sticky so only an item's owner can remove it.
# The Sniffer shows it on the startup disk. Never changed once made.
make_shared_documents() {
	[ -e /home/Shared ] && return 0
	mkdir -p /home/Shared && chmod 1777 /home/Shared ||
		echo "zacos9: could not make the Shared Documents folder." >&2
}

# Compressed Memory is off until the Memory control panel turns it on, but
# Debian's systemd-zram-generator turns a zram0 device on by default
# (/usr/lib/systemd/zram-generator.conf). A file in /etc with no [zram0]
# section overrides it; the panel's helper rewrites it from then on.
zram_off_by_default() {
	[ -e /etc/systemd/zram-generator.conf ] && return 0
	mkdir -p /etc/systemd &&
	printf '%s\n' "# Written by the zacos9 package: Compressed Memory is off." \
		"# Turn it on in the Memory control panel." >/etc/systemd/zram-generator.conf ||
		echo "zacos9: could not turn the default compressed memory off." >&2
}

# The old RDP sharing (zacos9-screen-sharing, removed after 1.0.19) wrote
# its services to /run/systemd/system and its keys and xrdp settings to
# /etc/zacos9/rdp. Stop any still running and delete what it made.
remove_rdp_sharing() {
	for unit in zacos9-rdp-listener zacos9-rdp-bridge zacos9-rdp-auth; do
		[ -e "/run/systemd/system/$unit.service" ] || continue
		systemctl stop "$unit.service" >/dev/null 2>&1 || true
		rm -f "/run/systemd/system/$unit.service"
		reload=1
	done
	[ -z "${reload:-}" ] || systemctl daemon-reload >/dev/null 2>&1 || true
	rm -rf /etc/zacos9/rdp /run/zacos9-rdp
}

# Japanese, on a Japanese install only: the installer writes LANG=ja_JP.UTF-8
# to /etc/default/locale when Japanese is chosen. Then the locale is made and
# the Numbers/Text panels' file (~/.config/locale.conf, which zacos9-session
# reads at login) is seeded for every account that has not chosen a locale
# itself. /etc/skel gets one too, so new accounts -- and the Guest account,
# whose home is refilled from skel -- start in Japanese as well. An account's
# own locale.conf is never replaced. Fcitx 5 with Mozc and the CJK fonts are
# package dependencies; its autostart entry starts it only in a Japanese
# session (zacos9-fcitx-autostart), and its Japanese defaults (keyboard-jp +
# Mozc, active by default) are in a config directory of their own under
# /usr/share/zacos9/japanese/xdg.
seed_locale_conf() {
	home=$1 user=$2
	conf="$home/.config/locale.conf"
	[ -e "$conf" ] && return 0
	mkdir -p "$home/.config" || return 0
	printf '%s\n' \
		'LANG=ja_JP.UTF-8' \
		'LANGUAGE=ja_JP' \
		'LC_COLLATE=ja_JP.UTF-8' \
		'LC_NUMERIC=ja_JP.UTF-8' \
		'LC_MONETARY=ja_JP.UTF-8' \
		'LC_TIME=ja_JP.UTF-8' \
		'LC_MEASUREMENT=ja_JP.UTF-8' \
		'LC_PAPER=ja_JP.UTF-8' >"$conf" || return 0
	if [ -n "$user" ]; then
		chown "$user" "$home/.config" "$conf" 2>/dev/null || true
	fi
}

system_language_is_japanese() {
	lang=
	for file in /etc/default/locale /etc/locale.conf; do
		[ -r "$file" ] || continue
		lang=$(sed -n 's/^LANG=//p' "$file" | tail -n 1)
		if [ -n "$lang" ]; then
			break
		fi
	done
	lang=${lang%\"}; lang=${lang#\"}; lang=${lang%\'}; lang=${lang#\'}
	case $lang in
	ja | ja_* | ja.* | ja@*) return 0 ;;
	esac
	return 1
}

japanese_setup() {
	system_language_is_japanese || return 0
	if command -v locale-gen >/dev/null 2>&1; then
		if [ -f /etc/locale.gen ]; then
			sed -i 's/^# *\(ja_JP\.UTF-8 UTF-8\)/\1/' /etc/locale.gen || true
		fi
		locale-gen ja_JP.UTF-8 >/dev/null 2>&1 ||
			echo "zacos9: could not make the ja_JP.UTF-8 locale." >&2
	fi
	seed_locale_conf /etc/skel ""
	getent passwd | while IFS=: read -r user _ uid _ _ home _; do
		case "$uid" in ''|*[!0-9]*) continue ;; esac
		if [ "$uid" -ge 1000 ] && [ "$uid" -lt 65534 ] && [ -d "$home" ]; then
			seed_locale_conf "$home" "$user"
		fi
	done
}

case "$1" in
	configure)
		zram_off_by_default
		redraw_grub_logo
		rotate_boot
		make_shared_documents
		japanese_setup
		remove_rdp_sharing
		# Software Update's daily check, for every account.
		systemctl --global enable zacos9-update-check.timer >/dev/null 2>&1 || true
		;;
esac

#DEBHELPER#

exit 0
