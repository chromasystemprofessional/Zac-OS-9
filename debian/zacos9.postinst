#!/bin/sh
# Classic: an Old World ROM needs SheepShaver to map the Mac's low-memory
# globals at address 0, which Linux refuses without CAP_SYS_RAWIO
# ("Cannot map Low Memory Globals: Operation not permitted"). Grant that
# one capability to the packaged emulator alone, rather than lowering
# vm.mmap_min_addr for the whole system. Re-run by the file trigger when
# zacos9-emulators replaces the binary.
set -e

sheepshaver=/usr/libexec/zacos9/SheepShaver

grant_rawio() {
	[ -f "$sheepshaver" ] || return 0
	if ! setcap cap_sys_rawio=ep "$sheepshaver" 2>/dev/null; then
		echo "zacos9: could not give SheepShaver the low-memory permission;" \
			"Old Dog may not start with an Old World ROM." >&2
	fi
}

# GRUB's start-up picture (/etc/grub.d/09_zacos9) is drawn once by
# zacos9-install for the screen's size; draw it again at that size so an
# upgrade's new boot art shows from the first moment, not only from the
# splash on. Same file name, so GRUB's config needs no update.
redraw_grub_logo() {
	[ -f /boot/grub/zacos9-logo.png ] || return 0
	/usr/libexec/zacos9/zacos9-bootlogo --redraw /boot/grub/zacos9-logo.png ||
		echo "zacos9: could not redraw the start-up picture." >&2
}

# Shared Documents (Mac OS 9's Multiple Users): one folder everyone on the
# computer can put things in, sticky so only an item's owner can remove it.
# The Sniffer shows it on the startup disk. Never changed once made.
make_shared_documents() {
	[ -e /home/Shared ] && return 0
	mkdir -p /home/Shared && chmod 1777 /home/Shared ||
		echo "zacos9: could not make the Shared Documents folder." >&2
}

# Printers set up by cups-browsed (device-uri implicitclass://...) only
# print while it runs, and the package conflicts with it: CUPS finds the
# same printers by itself (IPP Everywhere) and sets them up as they're
# used. Remove the leftovers, their stuck documents with them.
remove_browsed_queues() {
	command -v lpstat >/dev/null 2>&1 && command -v lpadmin >/dev/null 2>&1 || return 0
	lpstat -v 2>/dev/null | sed -n 's/^device for \([^:]*\): implicitclass:.*/\1/p' |
	while IFS= read -r queue; do
		lpadmin -x "$queue" 2>/dev/null ||
			echo "zacos9: could not remove cups-browsed's printer \"$queue\"." >&2
	done
}

case "$1" in
	configure)
		grant_rawio
		redraw_grub_logo
		make_shared_documents
		remove_browsed_queues
		# Software Update's daily check, for every account.
		systemctl --global enable zacos9-update-check.timer >/dev/null 2>&1 || true
		;;
	triggered)
		grant_rawio
		;;
esac

#DEBHELPER#

exit 0
