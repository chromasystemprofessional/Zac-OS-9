#!/bin/sh
# zacos9-accounts-helper: the privileged half of the Users control panel's
# computer-wide settings (gap plan 5.2, 5.3). It runs as root through
# pkexec; polkit lets administrators at the computer use it
# (org.zacos9.accounts).
#
#   zacos9-accounts-helper puppy USER on|off
#                       Puppy Mode for USER, set by an administrator: the
#                       Sniffer keeps only the essential commands, and USER
#                       can't turn it off (lib/settings.c reads it)
#   zacos9-accounts-helper guest on|off
#                       the Guest account: "guest", no password; its home is
#                       emptied at each login (session/zacos9-session)
#   zacos9-accounts-helper welcome
#                       the login window's welcome message, from stdin (at
#                       most 200 characters; empty: the standard one)
#   zacos9-accounts-helper status
#                       "guest on|off", then "puppy USER" lines
#
# Everything lives in /etc/zacos9 (ZACOS9_ACCOUNTS_CONF, for tests), readable
# by everyone: puppy/USER (empty files), welcome, guest-account (the guest's
# user name, so only that account is ever emptied).
set -eu

CONF=${ZACOS9_ACCOUNTS_CONF:-/etc/zacos9}
GUEST=guest

die() {
	echo "$*" >&2
	exit 1
}

valid_user() {
	case $1 in
	'' | -* | *[!a-z0-9_-]*) return 1 ;;
	esac
	# Tests name accounts that only their stand-in accountsservice has
	# (pkexec never passes ZACOS9_ACCOUNTS_CONF on).
	[ -n "${ZACOS9_ACCOUNTS_CONF:-}" ] || getent passwd "$1" >/dev/null
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
puppy)
	[ $# -eq 2 ] || die "usage: puppy USER on|off"
	valid_user "$1" || die "There is no account named \"$1\"."
	mkdir -p "$CONF/puppy"
	chmod 755 "$CONF" "$CONF/puppy"
	case $2 in
	on) : >"$CONF/puppy/$1" && chmod 644 "$CONF/puppy/$1" ;;
	off) rm -f "$CONF/puppy/$1" ;;
	*) die "usage: puppy USER on|off" ;;
	esac
	;;
guest)
	[ $# -eq 1 ] || die "usage: guest on|off"
	mkdir -p "$CONF"
	case $1 in
	on)
		if ! getent passwd "$GUEST" >/dev/null; then
			adduser --quiet --disabled-password --comment "Guest" "$GUEST" >&2 ||
				die "The Guest account couldn't be made."
		elif [ "$(cat "$CONF/guest-account" 2>/dev/null)" != "$GUEST" ]; then
			die "There is already an account named \"$GUEST\" that isn't the Guest account."
		fi
		passwd -d "$GUEST" >/dev/null # no password
		echo "$GUEST" >"$CONF/guest-account"
		chmod 644 "$CONF/guest-account"
		;;
	off)
		if [ "$(cat "$CONF/guest-account" 2>/dev/null)" = "$GUEST" ]; then
			deluser --quiet --remove-home "$GUEST" >&2 || true
		fi
		rm -f "$CONF/guest-account"
		;;
	*) die "usage: guest on|off" ;;
	esac
	;;
welcome)
	mkdir -p "$CONF"
	text=$(head -c 200 | tr -d '\000-\010\013-\037' | tr '\n' ' ' | sed 's/ *$//')
	if [ -z "$text" ]; then
		rm -f "$CONF/welcome"
	else
		printf '%s\n' "$text" >"$CONF/welcome"
		chmod 644 "$CONF/welcome"
	fi
	;;
status)
	if [ -s "$CONF/guest-account" ]; then echo "guest on"; else echo "guest off"; fi
	for f in "$CONF"/puppy/*; do
		[ -e "$f" ] && echo "puppy ${f##*/}"
	done
	;;
*)
	die "usage: zacos9-accounts-helper puppy|guest|welcome|status ..."
	;;
esac
