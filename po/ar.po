#: shell/disksetup/main.cpp:80 shell/disksetup/main.cpp:1027
msgid "Disk Setup"
msgstr "إعداد القرص"

#: shell/disksetup/plan.cpp:156
msgid "ZacOS (ext4)"
msgstr "ZacOS (ext4)"

#: shell/disksetup/plan.cpp:156
msgid "Haiku (BFS)"
msgstr "Haiku (BFS)"

#: shell/disksetup/plan.cpp:157
msgid "Mac OS Extended"
msgstr "Mac OS Extended"

#: shell/disksetup/plan.cpp:158
msgid "unformatted"
msgstr "غير مهيأ"

#: shell/disksetup/plan.cpp:162 shell/installer/installer.cpp:51
#: shell/installer/installer.cpp:447 shell/installer/installer.cpp:746
msgid "“%1”"
msgstr "“%1”"

#: shell/disksetup/plan.cpp:162
msgid "the EFI System partition"
msgstr "قسم نظام EFI"

#: shell/disksetup/plan.cpp:163
msgid "the BIOS boot partition"
msgstr "قسم إقلاع BIOS"

#: shell/disksetup/plan.cpp:164
msgid "the new partition"
msgstr "القسم الجديد"

#: shell/disksetup/plan.cpp:171
msgid "Erase %1 and give it a new %2 partition table"
msgstr "امسح %1 وأنشئ له جدول أقسام %2 جديدًا"

#: shell/disksetup/plan.cpp:173
msgid "Delete %1 (%2)"
msgstr "حذف %1 (%2)"

#: shell/disksetup/plan.cpp:176
msgid "Make a %1 BIOS boot partition, for starting up with GRUB"
msgstr "أنشئ قسم إقلاع BIOS بحجم %1 للإقلاع باستخدام GRUB"

#: shell/disksetup/plan.cpp:179
msgid "Make a %1 EFI System partition, for starting up"
msgstr "أنشئ قسم نظام EFI بحجم %1 للإقلاع"

#: shell/disksetup/plan.cpp:181
msgid "Make a %1 %2 partition%3"
msgstr "أنشئ قسم %2 بحجم %1%3"

#: shell/disksetup/plan.cpp:182
msgid " named “%1”"
msgstr " باسم “%1”"

#: shell/disksetup/plan.cpp:184
msgid "Erase %1 as %2%3"
msgstr "امسح %1 بتنسيق %2%3"

#: shell/disksetup/plan.cpp:185
msgid ", named “%1”"
msgstr "، باسم “%1”"

#: shell/disksetup/plan.cpp:187
msgid "Resize %1 to %2"
msgstr "غيّر حجم %1 إلى %2"

#: shell/disksetup/plan.cpp:203
msgid "ZacOS is running from this drive, so it can't be changed."
msgstr "يعمل ZacOS من هذا القرص، لذا لا يمكن تغييره."

#: shell/disksetup/plan.cpp:209
msgid "The running system is on this drive, so it can't be erased."
msgstr "النظام العامل على هذا القرص، لذا لا يمكن مسحه."

#: shell/disksetup/plan.cpp:213 shell/disksetup/plan.cpp:227
msgid "%1 is in use. Eject it first."
msgstr "%1 قيد الاستخدام. أخرجه أولًا."

#: shell/disksetup/plan.cpp:216
msgid "Choose GPT or MBR."
msgstr "اختر GPT أو MBR."

#: shell/disksetup/plan.cpp:221
msgid "Choose a partition."
msgstr "اختر قسمًا."

#: shell/disksetup/plan.cpp:224
msgid "Apply the changes so far first."
msgstr "طبّق التغييرات الحالية أولًا."

#: shell/disksetup/plan.cpp:230
msgid "The running system starts up from the EFI System partition, so it can't be deleted or erased."
msgstr "يبدأ النظام العامل من قسم نظام EFI، لذا لا يمكن حذفه أو مسحه."

#: shell/disksetup/plan.cpp:233 shell/disksetup/plan.cpp:255
msgid "Choose a format."
msgstr "اختر تنسيقًا."

#: shell/disksetup/plan.cpp:237
msgid "%1 can't be resized: only ZacOS (ext4) and NTFS partitions can."
msgstr "لا يمكن تغيير حجم %1: يمكن ذلك لأقسام ZacOS (ext4) وNTFS فقط."

#: shell/disksetup/plan.cpp:242
msgid "Choose a size between 16 MB and %1."
msgstr "اختر حجمًا بين 16 MB و%1."

#: shell/disksetup/plan.cpp:245
msgid "%1 can't be made smaller than %2: its files need that much."
msgstr "لا يمكن تصغير %1 عن %2: ملفاته تحتاج إلى ذلك."

#: shell/disksetup/plan.cpp:252
msgid "Give the drive a partition table first."
msgstr "أنشئ جدول أقسام للقرص أولًا."

#: shell/disksetup/plan.cpp:259
msgid "That kind of partition can't go on this drive."
msgstr "لا يمكن وضع هذا النوع من الأقسام على هذا القرص."

#: shell/disksetup/plan.cpp:262
msgid "An MBR drive holds four partitions at most."
msgstr "يستوعب قرص MBR أربعة أقسام كحد أقصى."

#: shell/disksetup/plan.cpp:269
msgid "There isn't room for that partition there."
msgstr "لا توجد مساحة لهذا القسم هناك."

#: shell/finder/desktop.cpp:118 shell/finder/viewoptionsdialog.cpp:438
msgid "Trash"
msgstr "سلة المهملات"

#: shell/finder/diskinit.cpp:453
msgid "The disk has been initialized as FAT32 with the name you entered. It will appear on the desktop when mounted."
msgstr "تم تهيئة القرص بصيغة FAT32 بالاسم الذي أدخلته. سيظهر على سطح المكتب عند تحميله."

#: shell/finder/diskinit.cpp:474
msgid "Select a mounted USB disk to erase. Internal and system disks cannot be erased here."
msgstr "اختر قرص USB محمّلًا لمسحه. لا يمكن مسح الأقراص الداخلية والنظامية هنا."

#: shell/finder/fileops.cpp:88
msgid "The font files changed, but the font cache could not be updated for %1. %2"
msgstr "تغيّرت ملفات الخطوط، لكن تعذّر تحديث ذاكرة الخطوط المؤقتة لـ %1. %2"

#: shell/finder/fileops.cpp:98
msgid "The font files changed, but fc-cache could not be started."
msgstr "تغيّرت ملفات الخطوط، لكن تعذّر بدء fc-cache."

#: shell/finder/fileops.cpp:113
msgid "This font cannot be removed: %1. Only your own installed fonts can be moved out or put in Trash. Option-drag to export a copy instead."
msgstr "لا يمكن إزالة هذا الخط: %1. يمكن فقط نقل الخطوط التي ثبّتها بنفسك أو وضعها في سلة المهملات. اسحب مع Option لتصدير نسخة بدلًا من ذلك."

#: shell/finder/fileops.cpp:127
msgid "Moving a font collection removes every font face in that file. Continue?"
msgstr "نقل مجموعة خطوط يزيل كل نمط خط في ذلك الملف. هل تريد المتابعة؟"

#: shell/finder/fileops.cpp:150
msgid "The font could not be moved to Trash: %1"
msgstr "تعذّر نقل الخط إلى سلة المهملات: %1"

#: shell/finder/fileops.cpp:323 shell/finder/fileops.cpp:351
msgid "The alias cannot be made because its original or destination is unavailable."
msgstr "لا يمكن إنشاء الاسم المستعار لأن الأصل أو الوجهة غير متاحين."

#: shell/finder/fileops.cpp:334 shell/finder/fileops.cpp:362
msgid "The alias could not be created in %1. Check folder permissions."
msgstr "تعذّر إنشاء الاسم المستعار في %1. تحقق من أذونات المجلد."

#: shell/finder/fileops.cpp:340
msgid "The alias was not created because its identity record could not be saved."
msgstr "لم يُنشأ الاسم المستعار لأن سجل هويته تعذّر حفظه."

#: shell/finder/fileops.cpp:392
msgid "Another file transfer is in progress. Finish or stop it first."
msgstr "هناك نقل ملفات آخر قيد التنفيذ. أكمِلْه أو أوقفه أولًا."

#: shell/finder/fileops.cpp:403
msgid "The destination folder is unavailable. Nothing was transferred."
msgstr "مجلد الوجهة غير متاح. لم يُنقل أي شيء."

#: shell/finder/fileops.cpp:417
msgid "Queued applications cannot be copied or moved as files. Use Put Away or drag back to Applications to cancel removal."
msgstr "لا يمكن نسخ التطبيقات في قائمة الانتظار أو نقلها كملفات. استخدم «إرجاع» أو اسحبها إلى التطبيقات لإلغاء الإزالة."

#: shell/finder/fileops.cpp:427
msgid "A folder cannot be transferred into itself, including through an alias."
msgstr "لا يمكن نقل مجلد إلى داخله، حتى عبر اسم مستعار."

#: shell/finder/fileops.cpp:441
msgid "“%1” already exists in the destination and was not replaced."
msgstr "“%1” موجود بالفعل في الوجهة ولم يُستبدل."

#: shell/finder/fileops.cpp:459
msgid "More than one selected item has the same destination name: “%1”. The duplicate was not transferred."
msgstr "أكثر من عنصر محدد له اسم الوجهة نفسه: “%1”. لم يُنقل المكرر."

#: shell/finder/fileops.cpp:468
msgid "The resource fork for “%1” cannot be transferred safely; the file has not been moved."
msgstr "لا يمكن نقل فرع الموارد لـ “%1” بأمان؛ لم يُنقل الملف."

#: shell/finder/fileops.cpp:846
msgid "“%1” stays in the Applications folder. To remove an application, select it and choose Move To Trash."
msgstr "يبقى “%1” في مجلد التطبيقات. لإزالة تطبيق، حدده واختر «نقل إلى سلة المهملات»."

#: shell/finder/fileops.cpp:849
msgid "To stop “%1” opening at login, drag it to the Trash."
msgstr "لإيقاف فتح “%1” عند تسجيل الدخول، اسحبه إلى سلة المهملات."

#: shell/finder/fileops.cpp:852
msgid "“%1” is part of this computer and can't be moved out of its window."
msgstr "“%1” جزء من هذا الحاسوب ولا يمكن نقله خارج نافذته."

#: shell/finder/fileops.cpp:951
msgid "“%1” isn't an application. Only applications can be startup items."
msgstr "“%1” ليس تطبيقًا. يمكن للتطبيقات فقط أن تكون عناصر بدء تشغيل."

#: shell/finder/fileops.cpp:979
msgid "The dragged control panel information is invalid."
msgstr "معلومات لوحة التحكم المسحوبة غير صالحة."

#: shell/finder/fileops.cpp:1018
msgid "The dragged module information is invalid."
msgstr "معلومات الوحدة المسحوبة غير صالحة."

#: shell/finder/fileops.cpp:1087
msgid "The dragged extension information is invalid."
msgstr "معلومات الإضافة المسحوبة غير صالحة."

#: shell/finder/fileops.cpp:1103
msgid "That is not an extension the Extensions Manager knows."
msgstr "هذه ليست إضافة يعرفها مدير الإضافات."

#: shell/finder/fileops.cpp:1207
msgid "The clipping couldn't be made. %1"
msgstr "تعذّر إنشاء القصاصة. %1"

#: shell/finder/fileops.cpp:1231
msgid "The dragged font information is invalid."
msgstr "معلومات الخط المسحوبة غير صالحة."

#: shell/finder/fileops.cpp:1342
msgid "The dragged application information is invalid."
msgstr "معلومات التطبيق المسحوبة غير صالحة."

#: shell/finder/fileops.cpp:1349
msgid "The dragged application is no longer available."
msgstr "التطبيق المسحوب لم يعد متاحًا."

#: shell/finder/fileops.cpp:1382
msgid "This drag source does not support aliases. Use File > Make Alias instead."
msgstr "مصدر السحب هذا لا يدعم الأسماء المستعارة. استخدم «ملف > إنشاء اسم مستعار» بدلًا من ذلك."

#: shell/finder/fileops.cpp:1393
msgid "Aliases must be placed in a real folder or on the Desktop."
msgstr "يجب وضع الأسماء المستعارة في مجلد حقيقي أو على سطح المكتب."

#: shell/finder/fileops.cpp:1401 shell/finder/fileops.cpp:1413
msgid "The dragged alias information is invalid."
msgstr "معلومات الاسم المستعار المسحوبة غير صالحة."

#: shell/finder/fileops.cpp:1487
msgid "The user Fonts folder could not be created: %1"
msgstr "تعذّر إنشاء مجلد الخطوط للمستخدم: %1"

#: shell/finder/fileops.cpp:1585
msgid "The other items do not belong in the System Folder itself. Put each where it belongs, inside one of its folders."
msgstr "العناصر الأخرى لا تنتمي إلى مجلد النظام نفسه. ضع كل واحد منها في مكانه داخل أحد مجلداته."

#: shell/finder/fileops.cpp:1602
msgid "Items in the System Folder belong in one of the folders inside it (such as Appearance, Extensions or Fonts)."
msgstr "عناصر مجلد النظام تنتمي إلى أحد مجلداته (مثل المظهر أو الإضافات أو الخطوط)."

