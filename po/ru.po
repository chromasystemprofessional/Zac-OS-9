msgstr "Открыть звукозапись"

#: shell/barkrecorder/barkrecorder.cpp:199
msgid "Choose a readable .wav file, and stop recording before playback."
msgstr "Выберите читаемый файл .wav и остановите запись перед воспроизведением."

#: shell/barkrecorder/barkrecorder.cpp:206
msgid "The audio command exited with status %1."
msgstr "Аудиокоманда завершилась с кодом %1."

#: shell/barkrecorder/barkrecorder.cpp:208
