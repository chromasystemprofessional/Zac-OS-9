msgstr "Saisissez un nom de recherche enregistrée de 1 à 80 caractères."

#: shell/finder/findcriteria.cpp:493
msgid "No query destination was provided."
msgstr "Aucune destination de requête n'a été fournie."

#: shell/finder/findcriteria.cpp:547
msgid "The saved search has invalid criteria: %1"
msgstr "La recherche enregistrée contient des critères invalides : %1"

#: shell/finder/findcriteria.cpp:553
msgid "The saved search could not be found or has invalid criteria."
msgstr ""
"La recherche enregistrée est introuvable ou contient des critères invalides."

#: shell/finder/finder.cpp:75
msgid ""
"The web search could not be opened. Check that a web browser is available."
