#: shell/finder/findcriteria.cpp:416
msgid "Could not create the saved searches folder."
msgstr "Impossible de créer le dossier des recherches enregistrées."

#: shell/finder/findcriteria.cpp:421
msgid "Could not write saved searches: %1"
msgstr "Impossible d'écrire les recherches enregistrées : %1"

#: shell/finder/findcriteria.cpp:426
msgid "Could not save Find searches: %1"
msgstr "Impossible d'enregistrer les recherches de Rechercher : %1"

#: shell/finder/findcriteria.cpp:456
