#: shell/disksetup/main.cpp:80 shell/disksetup/main.cpp:1027
msgid "Disk Setup"
msgstr "Configuração de disco"

#: shell/disksetup/plan.cpp:156
msgid "ZacOS (ext4)"
msgstr "ZacOS (ext4)"

#: shell/disksetup/plan.cpp:156
msgid "Haiku (BFS)"
msgstr "Haiku (BFS)"

#: shell/disksetup/plan.cpp:157
msgid "Mac OS Extended"
msgstr "Mac OS Extended"

#: shell/disksetup/plan.cpp:158
msgid "unformatted"
msgstr "não formatado"

#: shell/disksetup/plan.cpp:162 shell/installer/installer.cpp:57
#: shell/installer/installer.cpp:460 shell/installer/installer.cpp:760
msgid "“%1”"
msgstr "“%1”"

#: shell/disksetup/plan.cpp:162
msgid "the EFI System partition"
msgstr "a partição do sistema EFI"

#: shell/disksetup/plan.cpp:163
msgid "the BIOS boot partition"
msgstr "a partição de inicialização BIOS"

#: shell/disksetup/plan.cpp:164
msgid "the new partition"
msgstr "a nova partição"

#: shell/disksetup/plan.cpp:171
msgid "Erase %1 and give it a new %2 partition table"
msgstr "Apagar %1 e criar uma nova tabela de partições %2"

#: shell/disksetup/plan.cpp:173
msgid "Delete %1 (%2)"
msgstr "Excluir %1 (%2)"

#: shell/disksetup/plan.cpp:176
msgid "Make a %1 BIOS boot partition, for starting up with GRUB"
msgstr "Criar uma partição de inicialização BIOS de %1 para iniciar com o GRUB"

#: shell/disksetup/plan.cpp:179
msgid "Make a %1 EFI System partition, for starting up"
msgstr "Criar uma partição do sistema EFI de %1 para iniciar"

#: shell/disksetup/plan.cpp:181
msgid "Make a %1 %2 partition%3"
msgstr "Criar uma partição %2 de %1%3"

#: shell/disksetup/plan.cpp:182
msgid " named “%1”"
msgstr " chamada “%1”"

#: shell/disksetup/plan.cpp:184
msgid "Erase %1 as %2%3"
msgstr "Apagar %1 como %2%3"

#: shell/disksetup/plan.cpp:185
msgid ", named “%1”"
msgstr ", chamada “%1”"

#: shell/disksetup/plan.cpp:187
msgid "Resize %1 to %2"
msgstr "Redimensionar %1 para %2"

#: shell/disksetup/plan.cpp:203
msgid "ZacOS is running from this drive, so it can't be changed."
msgstr "O ZacOS está sendo executado a partir deste disco, então ele não pode ser alterado."

#: shell/disksetup/plan.cpp:209
msgid "The running system is on this drive, so it can't be erased."
msgstr "O sistema em execução está neste disco, então ele não pode ser apagado."

#: shell/disksetup/plan.cpp:213 shell/disksetup/plan.cpp:227
msgid "%1 is in use. Eject it first."
msgstr "%1 está em uso. Ejete-o primeiro."

#: shell/disksetup/plan.cpp:216
msgid "Choose GPT or MBR."
msgstr "Escolha GPT ou MBR."

#: shell/disksetup/plan.cpp:221
msgid "Choose a partition."
msgstr "Escolha uma partição."

#: shell/disksetup/plan.cpp:224
msgid "Apply the changes so far first."
msgstr "Aplique primeiro as alterações já feitas."

#: shell/disksetup/plan.cpp:230
msgid ""
"The running system starts up from the EFI System partition, so it can't be "
"deleted or erased."
msgstr "O sistema em execução inicia a partir da partição do sistema EFI, então ela não pode ser excluída ou apagada."

#: shell/disksetup/plan.cpp:233 shell/disksetup/plan.cpp:255
msgid "Choose a format."
msgstr "Escolha um formato."

#: shell/disksetup/plan.cpp:237
msgid "%1 can't be resized: only ZacOS (ext4) and NTFS partitions can."
msgstr "Não é possível redimensionar %1: apenas partições ZacOS (ext4) e NTFS."

#: shell/disksetup/plan.cpp:242
msgid "Choose a size between 16 MB and %1."
msgstr "Escolha um tamanho entre 16 MB e %1."

#: shell/disksetup/plan.cpp:245
msgid "%1 can't be made smaller than %2: its files need that much."
msgstr "%1 não pode ficar menor que %2: seus arquivos precisam desse espaço."

#: shell/disksetup/plan.cpp:252
msgid "Give the drive a partition table first."
msgstr "Primeiro atribua uma tabela de partições ao disco."

#: shell/disksetup/plan.cpp:259
msgid "That kind of partition can't go on this drive."
msgstr "Esse tipo de partição não pode ficar neste disco."

#: shell/disksetup/plan.cpp:262
msgid "An MBR drive holds four partitions at most."
msgstr "Um disco MBR comporta no máximo quatro partições."

#: shell/disksetup/plan.cpp:269
msgid "There isn't room for that partition there."
msgstr "Não há espaço para essa partição ali."

#: shell/finder/desktop.cpp:118 shell/finder/viewoptionsdialog.cpp:438
msgid "Trash"
msgstr "Lixo"

#: shell/finder/diskinit.cpp:453
msgid ""
"The disk has been initialized as FAT32 with the name you entered. It will "
"appear on the desktop when mounted."
msgstr "O disco foi inicializado como FAT32 com o nome digitado. Ele aparecerá na mesa quando for montado."

#: shell/finder/diskinit.cpp:474
msgid ""
"Select a mounted USB disk to erase. Internal and system disks cannot be "
"erased here."
msgstr "Selecione um disco USB montado para apagar. Discos internos e do sistema não podem ser apagados aqui."

#: shell/finder/fileops.cpp:88
msgid ""
"The font files changed, but the font cache could not be updated for %1. %2"
msgstr "Os arquivos de fontes mudaram, mas não foi possível atualizar o cache de fontes para %1. %2"

#: shell/finder/fileops.cpp:98
msgid "The font files changed, but fc-cache could not be started."
msgstr "Os arquivos de fontes mudaram, mas não foi possível iniciar o fc-cache."

#: shell/finder/fileops.cpp:113
msgid ""
"This font cannot be removed: %1. Only your own installed fonts can be moved "
"out or put in Trash. Option-drag to export a copy instead."
msgstr "Não é possível remover esta fonte: %1. Apenas as fontes instaladas por você podem ser movidas para fora ou para o Lixo. Arraste com Opção para exportar uma cópia."

#: shell/finder/fileops.cpp:127
msgid ""
"Moving a font collection removes every font face in that file. Continue?"
msgstr "Mover uma coleção de fontes remove todos os estilos desse arquivo. Continuar?"

#: shell/finder/fileops.cpp:150
msgid "The font could not be moved to Trash: %1"
msgstr "Não foi possível mover a fonte para o Lixo: %1"

#: shell/finder/fileops.cpp:323 shell/finder/fileops.cpp:351
msgid ""
"The alias cannot be made because its original or destination is unavailable."
msgstr "Não é possível criar o alias porque o original ou o destino não está disponível."

#: shell/finder/fileops.cpp:334 shell/finder/fileops.cpp:362
msgid "The alias could not be created in %1. Check folder permissions."
msgstr "Não foi possível criar o alias em %1. Verifique as permissões da pasta."

#: shell/finder/fileops.cpp:340
msgid ""
"The alias was not created because its identity record could not be saved."
msgstr "O alias não foi criado porque não foi possível salvar seu registro de identidade."

#: shell/finder/fileops.cpp:392
msgid "Another file transfer is in progress. Finish or stop it first."
msgstr "Já há outra transferência de arquivos em andamento. Termine-a ou pare-a primeiro."

#: shell/finder/fileops.cpp:403
msgid "The destination folder is unavailable. Nothing was transferred."
msgstr "A pasta de destino não está disponível. Nada foi transferido."

#: shell/finder/fileops.cpp:417
msgid ""
"Queued applications cannot be copied or moved as files. Use Put Away or drag "
"back to Applications to cancel removal."
msgstr "Aplicativos na fila de remoção não podem ser copiados ou movidos como arquivos. Use Guardar ou arraste de volta para Aplicativos para cancelar a remoção."

#: shell/finder/fileops.cpp:427
msgid "A folder cannot be transferred into itself, including through an alias."
msgstr "Uma pasta não pode ser transferida para dentro de si mesma, nem por meio de um alias."

#: shell/finder/fileops.cpp:441
msgid "“%1” already exists in the destination and was not replaced."
msgstr "“%1” já existe no destino e não foi substituído."

#: shell/finder/fileops.cpp:459
msgid ""
"More than one selected item has the same destination name: “%1”. The "
"duplicate was not transferred."
msgstr "Mais de um item selecionado tem o mesmo nome de destino: “%1”. A duplicata não foi transferida."

#: shell/finder/fileops.cpp:468
msgid ""
"The resource fork for “%1” cannot be transferred safely; the file has not "
"been moved."
msgstr "A ramificação de recursos de “%1” não pode ser transferida com segurança; o arquivo não foi movido."

#: shell/finder/fileops.cpp:846
msgid ""
"“%1” stays in the Applications folder. To remove an application, select it "
"and choose Move To Trash."
msgstr "“%1” permanece na pasta Aplicativos. Para remover um aplicativo, selecione-o e escolha Mover para o Lixo."

#: shell/finder/fileops.cpp:849
msgid "To stop “%1” opening at login, drag it to the Trash."
msgstr "Para impedir que “%1” abra ao iniciar sessão, arraste-o para o Lixo."

#: shell/finder/fileops.cpp:852
msgid "“%1” is part of this computer and can't be moved out of its window."
msgstr "“%1” faz parte deste computador e não pode ser movido para fora de sua janela."

#: shell/finder/fileops.cpp:951
msgid "“%1” isn't an application. Only applications can be startup items."
msgstr "“%1” não é um aplicativo. Apenas aplicativos podem ser itens de inicialização."

#: shell/finder/fileops.cpp:979
msgid "The dragged control panel information is invalid."
msgstr "As informações do painel de controle arrastado são inválidas."

#: shell/finder/fileops.cpp:1018
msgid "The dragged module information is invalid."
msgstr "As informações do módulo arrastado são inválidas."

#: shell/finder/fileops.cpp:1087
msgid "The dragged extension information is invalid."
msgstr "As informações da extensão arrastada são inválidas."

#: shell/finder/fileops.cpp:1103
msgid "That is not an extension the Extensions Manager knows."
msgstr "O Gerenciador de extensões não conhece essa extensão."

#: shell/finder/fileops.cpp:1207
msgid "The clipping couldn't be made. %1"
msgstr "Não foi possível criar o recorte. %1"

#: shell/finder/fileops.cpp:1231
msgid "The dragged font information is invalid."
msgstr "As informações da fonte arrastada são inválidas."

#: shell/finder/fileops.cpp:1342
msgid "The dragged application information is invalid."
msgstr "As informações do aplicativo arrastado são inválidas."

#: shell/finder/fileops.cpp:1349
msgid "The dragged application is no longer available."
msgstr "O aplicativo arrastado não está mais disponível."

#: shell/finder/fileops.cpp:1382
msgid ""
"This drag source does not support aliases. Use File > Make Alias instead."
msgstr "Esta origem de arraste não aceita aliases. Use Arquivo > Criar alias."

#: shell/finder/fileops.cpp:1393
msgid "Aliases must be placed in a real folder or on the Desktop."
msgstr "Aliases devem ser colocados em uma pasta real ou na mesa."

#: shell/finder/fileops.cpp:1401 shell/finder/fileops.cpp:1413
msgid "The dragged alias information is invalid."
msgstr "As informações do alias arrastado são inválidas."

#: shell/finder/fileops.cpp:1487
msgid "The user Fonts folder could not be created: %1"
msgstr "Não foi possível criar a pasta de fontes do usuário: %1"

#: shell/finder/fileops.cpp:1585
msgid ""
"The other items do not belong in the System Folder itself. Put each where it "
"belongs, inside one of its folders."
msgstr "Os outros itens não pertencem diretamente à Pasta Sistema. Coloque cada um no lugar certo, dentro de uma de suas pastas."

#: shell/finder/fileops.cpp:1602
msgid ""
"Items in the System Folder belong in one of the folders inside it (such as "
"Appearance, Extensions or Fonts)."
msgstr "Itens na Pasta Sistema devem ficar em uma das pastas dentro dela (como Aparência, Extensões ou Fontes)."

