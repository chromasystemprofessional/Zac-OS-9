#: shell/finder/findcriteria.cpp:398
msgid "Could not read saved searches: %1"
msgstr "No se pudieron leer las búsquedas guardadas: %1"

#: shell/finder/findcriteria.cpp:406 shell/finder/findcriteria.cpp:442
msgid "Saved searches are damaged or use an unsupported format."
msgstr "Las búsquedas guardadas están dañadas o usan un formato no compatible."

#: shell/finder/findcriteria.cpp:416
msgid "Could not create the saved searches folder."
msgstr "No se pudo crear la carpeta de búsquedas guardadas."

#: shell/finder/findcriteria.cpp:421
msgid "Could not write saved searches: %1"
msgstr "No se pudieron escribir las búsquedas guardadas: %1"

#: shell/finder/findcriteria.cpp:426
msgid "Could not save Find searches: %1"
msgstr "No se pudieron guardar las búsquedas: %1"

#: shell/finder/findcriteria.cpp:456
msgid "Enter a saved-search name of 1 to 80 characters."
msgstr "Escribe un nombre de búsqueda guardada de 1 a 80 caracteres."

#: shell/finder/findcriteria.cpp:493
msgid "No query destination was provided."
msgstr "No se indicó dónde guardar la búsqueda."

#: shell/finder/findcriteria.cpp:547
msgid "The saved search has invalid criteria: %1"
msgstr "La búsqueda guardada tiene criterios no válidos: %1"

#: shell/finder/findcriteria.cpp:553
msgid "The saved search could not be found or has invalid criteria."
msgstr "No se encontró la búsqueda guardada o tiene criterios no válidos."

#: shell/finder/finder.cpp:75
msgid ""
"The web search could not be opened. Check that a web browser is available."
msgstr "No se pudo abrir la búsqueda web. Comprueba que haya un navegador disponible."

#: shell/finder/finder.cpp:185
msgid ""
"The server disk \"%1\" has been disconnected. Connect to the server again to "
"use it. Unsaved changes may have been lost."
msgstr "El disco del servidor \"%1\" se ha desconectado. Vuelve a conectarte al servidor para usarlo. Es posible que se hayan perdido cambios sin guardar."

#: shell/finder/finder.cpp:190
msgid "Server Disconnected"
msgstr "Servidor desconectado"

#: shell/finder/finder.cpp:326
msgid "Force “%1” to quit? Any unsaved changes in it will be lost."
msgstr "¿Forzar la salida de «%1»? Se perderán los cambios sin guardar."

#: shell/finder/finder.cpp:327 shell/menubar/hints.c:20
#: shell/menubar/launch.c:523
msgid "Force Quit"
msgstr "Forzar salida"

#: shell/finder/finder.cpp:329
msgid "“%1” couldn't be forced to quit."
msgstr "No se pudo forzar la salida de «%1»."

#: shell/finder/finder.cpp:337
msgid "“%1” couldn't be attached to “%2”."
msgstr "No se pudo asociar «%1» a «%2»."

