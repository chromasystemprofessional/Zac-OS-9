// Administrators at the computer (in the sudo group, logged in on its
// screen) may stop and start printers, and make one every user's default,
// without a password: the print queue window has no way to ask for one.
// Other users and sessions keep cups-pk-helper's own defaults.
polkit.addRule(function(action, subject) {
	if ((action.id == "org.opensuse.cupspkhelper.mechanism.printer-enable" ||
			action.id == "org.opensuse.cupspkhelper.mechanism.printer-set-default") &&
			subject.local && subject.active && subject.isInGroup("sudo")) {
		return polkit.Result.YES;
	}
});
