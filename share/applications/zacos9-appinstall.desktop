[Desktop Entry]
Type=Application
Name=Installer
Name[fr_CA]=Installateur
Name[fr_FR]=Installateur
Name[pt]=Instalador de programas
Name[es]=Instalador de programas
Name[ru]=Установщик программ
Comment=Install applications dropped onto the Applications folder
Exec=zacos9-appinstall %F
NoDisplay=true
OnlyShowIn=ZacOS9;
