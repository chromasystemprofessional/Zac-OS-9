[Desktop Entry]
Type=Application
Name=Picture Viewer
Name[ar]=عارض الصور
Name[fr_CA]=Visionneuse d'images
Name[fr_FR]=Visionneuse d'images
Name[pt]=Visualizador de imagens
Name[es]=Visor de imágenes
Name[ru]=Просмотр изображений
Name[it]=Visualizzatore immagini
Comment=View pictures, fitted to the screen, and zoom in and out
Exec=zacos9-picture %F
Terminal=false
Categories=Graphics;Viewer;
OnlyShowIn=ZacOS9;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/x-bmp;image/webp;image/tiff;image/svg+xml;image/svg+xml-compressed;image/x-icon;image/vnd.microsoft.icon;image/x-icns;image/x-tga;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-portable-anymap;image/x-xbitmap;image/x-xpixmap;image/vnd.wap.wbmp;
