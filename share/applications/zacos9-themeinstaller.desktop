[Desktop Entry]
Type=Application
Name=Theme Installer
Comment=Build a ZacOS theme from a Mac OS 9 install
Exec=zacos9-themeinstaller
Terminal=false
Categories=Utility;
OnlyShowIn=ZacOS9;
# No menu entry: themes install by dropping the theme file into
# System Folder > Appearance > Theme Files (the catalog runs this tool).
NoDisplay=true;
