#!/bin/sh
# zacos9-classic: run classic Mac OS in an emulator window.
#
#   zacos9-classic [--check] [--68k] [--fullscreen|--windowed] [--disk IMAGE]... [--open APP]
#
# The screen fills the desktop at its resolution when the compositor's
# output list can be read; --windowed (or "screen=window" in classic.conf)
# keeps the 800x600 window instead.
#
# The user supplies Apple's files: ROMs and system disk images go in
# ~/Classic (or $ZACOS9_CLASSIC_DIR), up to two folders deep. ROMs are
# recognised by their checksum, disks by their HFS or
# partition-map signature, so file names don't matter.
#
# PowerPC (SheepShaver, Mac OS 7.5.2 to 9.0.4) is the default; --68k uses
# Basilisk II (System 7 to Mac OS 8.1). The home folder is shared with
# the Mac as the "Unix" volume. --check only reports what would run;
# problems go to stderr, one line, with exit status 2.
#
# --open APP asks the running (or newly started) Mac to open a Classic
# application from the shared Unix volume. A running session accepts further
# opens; it needs the patched SheepShaver and Classic Open Helper in the Mac's
# System Folder:Startup Items (emulation/classic-open).
#
# The Startup Disk control panel picks the disk the Mac starts up from
# ("startup-disk=PATH" in ~/.config/zacos9/classic.conf): it is attached
# first, and a CD is started from as a CD.
set -eu

classic_dir=${ZACOS9_CLASSIC_DIR:-$HOME/Classic}
classic_conf=${XDG_CONFIG_HOME:-$HOME/.config}/zacos9/classic.conf
self_dir=$(cd "$(dirname "$0")" && pwd)
check=false
arch=ppc
extra_disks=""
fullscreen=auto
open_path=""
queue_root=$HOME/zacos9-classic

while [ $# -gt 0 ]; do
	case $1 in
	--check) check=true ;;
	--68k) arch=68k ;;
	--fullscreen) fullscreen=yes ;;
	--windowed) fullscreen=no ;;
	--disk) [ $# -ge 2 ] || { echo "usage: zacos9-classic [--check] [--68k] [--fullscreen|--windowed] [--disk IMAGE]... [--open APP]" >&2; exit 64; }; shift; extra_disks="$extra_disks
$1" ;;
	--open) [ $# -ge 2 ] || { echo "usage: zacos9-classic [--check] [--68k] [--fullscreen|--windowed] [--disk IMAGE]... [--open APP]" >&2; exit 64; }; shift; open_path=$1 ;;
	*) echo "usage: zacos9-classic [--check] [--68k] [--fullscreen|--windowed] [--disk IMAGE]... [--open APP]" >&2; exit 64 ;;
	esac
	shift
done

fail() {
	echo "$1" >&2
	exit 2
}

# Direct launching only knows files on the shared Unix volume. The host
# home folder is the ExtFS root, so the Mac path is the relative path with
# colons instead of slashes.
map_open_path() {
	[ -n "$open_path" ] || return 0
	case $open_path in
	/*) ;;
	*) open_path=$(pwd)/$open_path ;;
	esac
	[ -f "$open_path" ] || fail "The Classic application \"$open_path\" was not found."
	case $open_path in
	"$HOME"/*) ;;
	*) fail "Classic applications must be in your home folder to open directly. Put this one in the Mac's Unix volume, or open it inside the Mac." ;;
	esac
	rel=${open_path#"$HOME"/}
	case $rel in
	''|*:*) fail "The Classic application's name contains a colon, which the Mac cannot use in a path. Rename it and try again." ;;
	esac
	case ":$rel:" in
	*:..:*) fail "The Classic application's path contains \"..\". Move it into a folder in your home folder and try again." ;;
	esac
	if printf '%s' "$rel" | LC_ALL=C grep -q '[^ -~]'; then
		fail "The Classic application's path has characters that direct launching cannot pass yet. Rename it to plain ASCII, or open it inside the Mac."
	fi
	# The bridge block holds 200 bytes including the terminator.
	[ ${#rel} -le 199 ] || fail "The Classic application's path is too long to open directly."
	guest_path=$(printf '%s' "$rel" | tr '/' ':')
}

runtime_dir() {
	if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
		echo "$XDG_RUNTIME_DIR/zacos9-classic"
	else
		echo "/tmp/zacos9-classic-$(id -u)"
	fi
}

session_alive() {
	[ -f "$pidfile" ] || return 1
	pid=$(cat "$pidfile" 2>/dev/null) || return 1
	case $pid in ''|*[!0-9]*) return 1 ;; esac
	kill -0 "$pid" 2>/dev/null
}

# A small versioned request, read by the patched emulator's Classic bridge.
# Every request gets a new name with a sequence number so the queue is easy to
# inspect; the bridge reads the directory afresh for each request.
queue_reset() {
	rm -rf "$queue_root/requests" "$queue_root/acks" "$queue_root/input"
	mkdir -p "$queue_root/requests" "$queue_root/acks" "$queue_root/input"
	chmod 700 "$queue_root" "$queue_root/requests" "$queue_root/acks" \
		"$queue_root/input" 2>/dev/null || true
	printf '0\n' > "$queue_root/sequence"
}

queue_request() {
	requests="$queue_root/requests"
	acks="$queue_root/acks"
	seqfile="$queue_root/sequence"
	seq=$(cat "$seqfile" 2>/dev/null || echo 0)
	case $seq in ''|*[!0-9]*) seq=0 ;; esac
	if [ "$seq" -gt 0 ]; then
		tries=0
		while [ ! -f "$acks/ack-$seq" ] && [ "$tries" -lt 50 ]; do
			sleep 0.1
			tries=$((tries + 1))
		done
		[ -f "$acks/ack-$seq" ] || fail "The Mac has not taken the previous open request yet. Try again in a moment."
	fi
	seq=$((seq + 1))
	printf '%s\n' "$seq" > "$seqfile"
	request_id=$seq
	id=$seq
	tmp="$requests/.request.$seq.tmp"
	printf 'version=1\nid=%s\npath=%s\n' "$id" "$guest_path" > "$tmp"
	mv "$tmp" "$requests/request.$seq.req"
}

# The main screen's resolution as the desktop shows it: the mode divided by
# its scale, turned for a rotated screen. The compositor publishes it in
# $XDG_RUNTIME_DIR/zacos9-outputs-$WAYLAND_DISPLAY:
#   output NAME WxH scale S nested 0|1 x X y Y main 0|1 rotate R
# A windowed or headless session has no such file and gets the window.
desktop_size() {
	runtime=${XDG_RUNTIME_DIR:-}
	display=${WAYLAND_DISPLAY:-}
	[ -n "$runtime" ] && [ -n "$display" ] || return 1
	[ -r "$runtime/zacos9-outputs-$display" ] || return 1
	while read -r kind name size scale_word scale nested_word nested \
			x_word x y_word y main_word main rotate_word rotate; do
		[ "$kind" = "output" ] && [ "$main" = "1" ] || continue
		width=${size%x*}
		height=${size#*x}
		case $width in ''|*[!0-9]*) continue ;; esac
		case $height in ''|*[!0-9]*) continue ;; esac
		case $scale in ''|*[!0-9.]*) scale=1 ;; esac
		width=$(awk -v n="$width" -v s="$scale" 'BEGIN { printf "%d", n / s + 0.5 }')
		height=$(awk -v n="$height" -v s="$scale" 'BEGIN { printf "%d", n / s + 0.5 }')
		case $rotate in
		90|270) turned=$width; width=$height; height=$turned ;;
		esac
		echo "$width $height"
		return 0
	done < "$runtime/zacos9-outputs-$display"
	return 1
}

# ROM checksums (the first four bytes), best first. SheepShaver wants an
# Old World PowerPC ROM; Basilisk II a 32-bit clean 68040 ROM.
PPC_ROMS="9630c68b 96cd923d 960fc647 960e4be9 9feb69b3 9b7a3aad"
M68K_ROMS="f1acad13 f1a6f343 420dbff3 3dc27823 ff7439ee 368cadfe 36b7fb6c"

checksum() {
	od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n'
}

candidates() {
	find -H "$classic_dir" -maxdepth 3 -type f 2>/dev/null
}

find_rom() {
	want=$1
	list=$(candidates)
	for sum in $want; do
		echo "$list" | while IFS= read -r f; do
			[ -n "$f" ] || continue
			size=$(wc -c <"$f")
			# 68k ROMs are 512K-1M; Old World PPC ROMs are 4M.
			case $size in 524288|1048576|4194304) ;; *) continue ;; esac
			if [ "$(checksum "$f")" = "$sum" ]; then
				echo "$f"
				break
			fi
		done | head -n 1 | grep . && return 0
	done
	# A New World "Mac OS ROM" file (from a Mac OS 9 CD) also suits SheepShaver.
	if [ "$want" = "$PPC_ROMS" ]; then
		echo "$list" | while IFS= read -r f; do
			[ -n "$f" ] && head -c 12 "$f" 2>/dev/null | grep -q '<CHRP-BOOT>' && echo "$f"
		done | head -n 1 | grep . && return 0
	fi
	return 1
}

# HFS ("BD"), HFS+ ("H+"/"HX") at 1024, or an Apple partition map ("ER").
is_mac_disk() {
	sig=$(dd if="$1" bs=1 skip=1024 count=2 2>/dev/null)
	case $sig in BD|H+|HX) return 0 ;; esac
	[ "$(dd if="$1" bs=1 count=2 2>/dev/null)" = "ER" ]
}

find_disks() {
	seen=""
	candidates | while IFS= read -r f; do
		[ -n "$f" ] || continue
		size=$(wc -c <"$f")
		[ "$size" -ge 409600 ] || continue
		# The same image in two folders is attached once.
		id="$size:$(basename "$f")"
		case $seen in *"|$id|"*) continue ;; esac
		seen="$seen|$id|"
		# Disks named for the other processor ("…(m68k).iso") stay out.
		name=$(basename "$f" | tr 'A-Z' 'a-z')
		case $arch:$name in ppc:*68k*|68k:*ppc*) continue ;; esac
		# .dsk/.hfv are emulator hard disks: blank ones count too, so
		# the Mac can initialise them.
		case $f in *.dsk|*.hfv) echo "$f"; continue ;; esac
		is_mac_disk "$f" && echo "$f"
	done
}

program_path() {
	for dir in "${ZACOS9_EMULATORS:-}" "$self_dir/../emulators/bin" \
			"$self_dir/../libexec/zacos9"; do
		[ -x "$dir/$1" ] && { echo "$(cd "$dir" && pwd)/$1"; return 0; }
	done
	command -v "$1"
}

emulator() {
	program_path "$1"
}

start_window_viewer() {
	[ "${ZACOS9_CLASSIC_WINDOWS:-1}" != 0 ] || return 0
	frontend=$(program_path zacos9-classic-windows 2>/dev/null || true)
	[ -n "$frontend" ] || return 0
	"$frontend" >/dev/null 2>&1 &
}

[ -d "$classic_dir" ] || fail "Put Macintosh ROM files and system disk images in the folder \"$(basename "$classic_dir")\" in your home folder."

if [ $arch = ppc ]; then
	program=SheepShaver
	rom=$(find_rom "$PPC_ROMS") || fail "No PowerPC Macintosh ROM was found in \"$(basename "$classic_dir")\". SheepShaver needs an Old World ROM (Power Mac 7200 to 9600) or a \"Mac OS ROM\" file."
	ram=268435456
else
	program=BasiliskII
	rom=$(find_rom "$M68K_ROMS") || fail "No 68040 Macintosh ROM was found in \"$(basename "$classic_dir")\". Basilisk II needs a Quadra or Centris ROM."
	ram=67108864
fi
exe=$(emulator $program) || fail "$program isn't installed. Build it with emulation/build-emulators.sh."

disks=$(printf '%s\n%s\n' "$extra_disks" "$(find_disks)" | grep . | awk '!seen[$0]++' || true)

# The chosen startup disk, if it is still there, goes first.
startup=$(sed -n 's/^startup-disk=//p' "$classic_conf" 2>/dev/null | tail -n 1)
if [ -n "$startup" ] && [ -f "$startup" ]; then
	disks=$(printf '%s\n%s\n' "$startup" "$disks" | grep . | awk '!seen[$0]++')
else
	startup=""
fi

# Installing from a CD image needs a hard disk to install onto: make a
# blank one (sparse, 2 GB), which the installer offers to initialise.
is_cd() {
	case $1 in *.iso|*.toast|*.cdr|*.ISO|*.TOAST|*.CDR) return 0 ;; esac
	return 1
}
has_cd=false has_hd=false
old_ifs=$IFS
IFS='
'
for d in $disks; do
	if is_cd "$d"; then has_cd=true; else has_hd=true; fi
done
IFS=$old_ifs
# Each processor gets its own: a 68k Mac can't start up from 9.
if [ $arch = ppc ]; then
	blank="$classic_dir/Macintosh HD (PPC).dsk"
else
	blank="$classic_dir/Macintosh HD (68k).dsk"
fi
if $has_cd && ! $has_hd; then
	if $check; then
		disks=$(printf '%s\n%s (blank, made at first start)\n' "$disks" "$blank")
	else
		truncate -s 2G "$blank"
		disks=$(printf '%s\n%s\n' "$disks" "$blank")
	fi
fi

# Full screen at the desktop's resolution, or the 800x600 window. The
# command line wins over classic.conf's "screen=", which wins over full
# screen when the compositor's output list is readable.
if [ "$fullscreen" = auto ]; then
	conf_screen=$(sed -n 's/^screen=//p' "$classic_conf" 2>/dev/null | tail -n 1)
	case $conf_screen in
	fullscreen) fullscreen=yes ;;
	window|windowed) fullscreen=no ;;
	esac
fi
screen=win/800/600
if [ "$fullscreen" != no ]; then
	size=$(desktop_size) || size=""
	if [ -n "$size" ]; then
		screen="dga/${size% *}/${size#* }"
	elif [ "$fullscreen" = yes ]; then
		# Asked for by hand, but the desktop's size can't be read.
		screen=dga/800/600
	fi
fi

map_open_path

if $check; then
	echo "emulator: $exe"
	echo "rom: $rom"
	echo "$disks" | sed -n 's/^./disk: &/p'
	[ -z "$startup" ] || echo "startup: $startup"
	echo "screen: $screen"
	[ -n "$disks" ] || echo "disks: none (the Mac will wait for a startup disk)"
	[ -z "$open_path" ] || echo "open: $open_path -> Unix:$guest_path"
	exit 0
fi

# One session owns the emulator and its disks. A running session accepts
# further direct opens one at a time; the emulator bridge reads each request
# directly, so the guest's ExtFS directory cache is no longer involved. A
# second plain launch leaves the running session alone.
runtime=$(runtime_dir)
pidfile=$runtime/session.pid
mkdir -p "$runtime"
chmod 700 "$runtime" 2>/dev/null || true
if [ -n "$open_path" ]; then
	if session_alive; then
		queue_request
		tries=0
		while [ ! -f "$queue_root/acks/ack-$request_id" ] && [ "$tries" -lt 50 ]; do
			sleep 0.1
			tries=$((tries + 1))
		done
		ack="$queue_root/acks/ack-$request_id"
		[ -f "$ack" ] || \
			fail "Classic did not open \"$open_path\". Classic Open Helper may be missing or busy."
		grep -q '^status=ok$' "$ack" || {
			code=$(sed -n 's/^code=//p' "$ack" | head -n 1)
			fail "The Mac refused \"$open_path\"${code:+ (Mac error $code)}."
		}
		echo "Classic is running; asked it to open $open_path." >&2
		exit 0
	fi
	queue_reset
	queue_request
	printf '%s\n' "$$" > "$pidfile"
else
	if session_alive; then
		echo "Classic is already running." >&2
		exit 0
	fi
	queue_reset
	printf '%s\n' "$$" > "$pidfile"
fi
start_window_viewer

set -- --rom "$rom" --ramsize $ram --screen "$screen" --extfs "$HOME" --nogui true
# A network through the emulator's own NAT: the Mac gets an address by DHCP
# and reaches this computer at 10.0.2.2 (its file sharing too, in the
# Chooser or Network Browser). This computer reaches the Mac's file
# sharing at localhost:5548 (host port, then the Mac's address, left empty
# for its own 10.0.2.15, then its port).
set -- "$@" --ether slirp --redir tcp:5548::548
# Hard disks first, so the Mac starts up from an installed system and
# only falls back to a CD; CD images are read-only ("*" prefix).
old_ifs=$IFS
IFS='
'
for d in $disks; do
	is_cd "$d" || set -- "$@" --disk "$d"
done
for d in $disks; do
	! is_cd "$d" || set -- "$@" --disk "*$d"
done
IFS=$old_ifs
# Started from a CD on purpose: the CD-ROM driver's number.
if [ -n "$startup" ] && is_cd "$startup"; then
	set -- "$@" --bootdriver -62
fi

# SDL's Wayland backend never shows a window here; Xwayland works.
# TODO: find out why (frame callbacks? libdecor?).
# The Classic bridge queue is only needed for direct --open requests.
# Leaving it unset for a plain launch keeps the patched emulator bridge
# dormant: on a freshly reset queue it otherwise segfaults shortly after
# the guest starts.
if [ -n "$open_path" ]; then
	export ZACOS9_CLASSIC_QUEUE="$queue_root"
fi
SDL_VIDEODRIVER=x11 SDL_AUDIODRIVER=${SDL_AUDIODRIVER:-pulseaudio} exec "$exe" "$@"
