#!/bin/sh
# Bloodhound: the search window. Its first home is the Sniffer's Find
# window; a later change gives it a window of its own.
set -eu
ctl=${ZACOS9_FINDER_CTL:-}
if [ -z "$ctl" ]; then
	self=$(readlink -f "$0")
	dir=$(dirname "$self")
	for candidate in "$dir/zacos9-finder-ctl" "$dir/../finderctl/zacos9-finder-ctl"; do
		if [ -x "$candidate" ]; then
			ctl=$candidate
			break
		fi
	done
fi
exec "${ctl:-zacos9-finder-ctl}" command find
