# The Macintosh view of this computer: the curated hierarchy, and the
# Applications folder built from XDG desktop entries. The test builds a
# private XDG environment, so it reads only its own desktop entries.
test('finder-vfs',
  executable('test-finder-vfs',
    '../../tests/finder/test_vfs.cpp',
    '../files/vfs.cpp',
    '../panels/xkblayouts.cpp',
    '../../compositor/src/kblayout.c',
    'folderpath.cpp',
    '../files/resources.cpp',
    '../files/autostart.cpp',
    '../files/extensioncatalog.cpp',
    '../files/appdb.cpp',
    '../files/apptrash.cpp',
    '../files/items.cpp', '../files/clippings.cpp', '../files/desktopprinter.cpp', '../files/printers.cpp', '../files/thumbnails.cpp', '../files/fileassoc.cpp', '../files/alias.cpp',
    link_with: panelkit,
    include_directories: include_directories('../print', '../panels', '../../compositor/src'),
    dependencies: [shell_common_dep, platinum_dep, qt6, gio, gio_unix, wayland_client, finder_fonts_dep, controlpanels_dep, collarmodules_dep, xkbcommon_client],
    cpp_args: ['-DZACOS9_RESOURCE_TESTING',
      '-DZACOS9_DESKTOP_ENTRIES="@0@"'.format(meson.project_source_root() / 'share/applications')],
  ),
  env: ['QT_QPA_PLATFORM=offscreen'],
  timeout: 180,
)

