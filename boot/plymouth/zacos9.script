# Keep a complete, independently centred splash on every display.
Window.SetBackgroundTopColor(1, 1, 1);
Window.SetBackgroundBottomColor(1, 1, 1);

logo_image = Image("logo.png");
box_image = Image("progress-box.png");
fill_source = Image("progress-fill.png");
fill_inner = box_image.GetWidth() - 4;
progress_width = 0;
password_image = NULL;
screens = [];
screen_count = 0;

fun refresh_callback() {
  x = 0;
  count = 0;
  for (i = 0; Window.GetWidth(i) != NULL; i++) {
    width = Window.GetWidth(i);
    height = Window.GetHeight(i);
    # Separate the script viewports so sprites for unequal displays never overlap.
    Window.SetX(i, x);
    Window.SetY(i, 0);
    if (screens[i] == NULL) {
      screens[i].logo = Sprite(logo_image);
      screens[i].box = Sprite(box_image);
      screens[i].fill = Sprite();
      screens[i].password = Sprite();
      screens[i].shown = -1;
    }
    cx = x + Math.Int(width / 2);
    cy = Math.Int(height / 2);
    box_x = cx - Math.Int(box_image.GetWidth() / 2);
    box_y = cy + Math.Int(logo_image.GetHeight() / 2) + 40;
    screens[i].logo.SetPosition(cx - Math.Int(logo_image.GetWidth() / 2),
                               cy - Math.Int(logo_image.GetHeight() / 2), 0);
    screens[i].box.SetPosition(box_x, box_y, 1);
    screens[i].fill.SetPosition(box_x + 2, box_y + 2, 2);
    if (screens[i].shown != progress_width) {
      if (progress_width > 0)
        screens[i].fill.SetImage(fill_source.Scale(progress_width, fill_source.GetHeight()));
      screens[i].shown = progress_width;
    }
    screens[i].password.SetImage(password_image);
    if (password_image != NULL)
      screens[i].password.SetPosition(cx - Math.Int(password_image.GetWidth() / 2), box_y + 30, 3);
    x += width;
    count++;
  }
  for (i = count; i < screen_count; i++)
    screens[i] = NULL;
  screen_count = count;
}
Plymouth.SetRefreshFunction(refresh_callback);
refresh_callback();

fun boot_progress_callback(duration, progress) {
  w = Math.Int(progress * fill_inner);
  if (w > fill_inner)
    w = fill_inner;
  if (w > progress_width)
    progress_width = w;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun display_password_callback(prompt, bullets) {
  password_image = Image.Text(prompt + "  " + bullets, 0, 0, 0);
  refresh_callback();
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  password_image = NULL;
  refresh_callback();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
