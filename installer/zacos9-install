#!/bin/sh
# zacos9-install: install ZacOS 9 from a live session to a hard disk.
#
#   zacos9-install DEVICE
#
# DEVICE is a block device path such as /dev/sda or /dev/nvme0n1.
# Must run as root (via pkexec). Progress is reported on stdout as
# lines of the form:
#
#   step N LABEL    — starting step N (of 6), with a short description
#   done            — installation complete
#   error MESSAGE   — fatal error
#
# Never pass user-controlled input directly to shell commands without
# quoting; DEVICE is validated below before any use.
set -eu

TARGET=/mnt/zacos9-install-target

# ---------- validate the device ----------
device=$1
case $device in
/dev/sd[a-z] | /dev/sd[a-z][a-z] | /dev/hd[a-z] | \
/dev/vd[a-z] | /dev/xvd[a-z] | /dev/nvme[0-9]n[0-9] | \
/dev/mmcblk[0-9])
	;;
*)
	echo "error Not a recognised block device: $device" >&2
	exit 1
	;;
esac
if ! [ -b "$device" ]; then
	echo "error Not a block device: $device"
	exit 1
fi

# Determine partition suffix: nvme/mmcblk use pN, others use N.
case $device in
*nvme* | *mmcblk*) part_suffix=p ;;
*) part_suffix= ;;
esac
efi_part="${device}${part_suffix}1"
root_part="${device}${part_suffix}2"

cleanup() {
	umount -R "$TARGET" 2>/dev/null || true
	rm -rf "$TARGET"
}
trap cleanup EXIT

# ---------- step 1: partition ----------
echo "step 1 Partitioning disk..."
rm -rf "$TARGET"
mkdir -p "$TARGET"
# Wipe any existing partition table so parted starts clean.
wipefs -a "$device" >/dev/null 2>&1 || true
parted -s "$device" mklabel gpt
parted -s "$device" mkpart ESP fat32 1MiB 513MiB
parted -s "$device" set 1 esp on
parted -s "$device" mkpart primary ext4 513MiB 100%
# Let the kernel re-read the new partition table.
partprobe "$device" 2>/dev/null || true
sleep 1

# ---------- step 2: format ----------
echo "step 2 Formatting partitions..."
mkfs.fat -F 32 -n "EFI" "$efi_part" >/dev/null
mkfs.ext4 -F -L "zacos9" "$root_part" >/dev/null 2>&1

# ---------- step 3: copy system ----------
echo "step 3 Copying system files..."
mount "$root_part" "$TARGET"
mkdir -p "$TARGET/boot/efi"
mount "$efi_part" "$TARGET/boot/efi"

# If we are running from a live session the entire live root is at /;
# rsync it to the target, skipping live-only and virtual paths.
rsync -aX \
	--exclude=/proc \
	--exclude=/sys \
	--exclude=/dev \
	--exclude=/run \
	--exclude=/tmp \
	--exclude=/media \
	--exclude=/mnt \
	--exclude=/live \
	--exclude=/cdrom \
	--exclude=/swapfile \
	/ "$TARGET/" 2>/dev/null || true
mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/run" \
         "$TARGET/tmp" "$TARGET/media" "$TARGET/mnt"

# ---------- step 4: configure for hard-disk boot ----------
echo "step 4 Configuring system..."

# Remove live-boot packages and config from the installed system.
mount --bind /dev "$TARGET/dev"
mount --bind /dev/pts "$TARGET/dev/pts"
mount --bind /proc "$TARGET/proc"
mount --bind /sys "$TARGET/sys"
mount --bind /sys/firmware/efi/efivars "$TARGET/sys/firmware/efi/efivars" 2>/dev/null || true

# Drop live-specific packages if present.
chroot "$TARGET" sh -c '
dpkg -l live-boot live-boot-initramfs-tools live-config live-config-systemd 2>/dev/null |
    grep "^ii" | awk "{print \$2}" |
    xargs --no-run-if-empty apt-get -y --purge remove >/dev/null 2>&1 || true
' || true

# Regenerate initramfs without live hooks.
chroot "$TARGET" update-initramfs -u >/dev/null 2>&1 || true

# fstab from the real UUIDs of the new partitions.
root_uuid=$(blkid -s UUID -o value "$root_part")
efi_uuid=$(blkid  -s UUID -o value "$efi_part")
cat > "$TARGET/etc/fstab" << FSTAB
# /etc/fstab: static file system information — generated by zacos9-install.
UUID=$root_uuid  /          ext4  defaults,errors=remount-ro  0  1
UUID=$efi_uuid   /boot/efi  vfat  umask=0077                  0  1
FSTAB

# Hostname.
echo "zacos9" > "$TARGET/etc/hostname"
printf "127.0.0.1\tlocalhost\n127.0.1.1\tzacos9\n" > "$TARGET/etc/hosts"

# ---------- step 5: install boot loader ----------
echo "step 5 Installing boot loader..."
chroot "$TARGET" grub-install \
	--target=x86_64-efi \
	--efi-directory=/boot/efi \
	--bootloader-id=ZacOS9 \
	--recheck "$device" >/dev/null 2>&1 || \
chroot "$TARGET" grub-install \
	--target=i386-pc \
	--recheck "$device" >/dev/null 2>&1
chroot "$TARGET" update-grub >/dev/null 2>&1

# ---------- step 6: clean up ----------
echo "step 6 Finishing..."
sync
umount -R "$TARGET"
rm -rf "$TARGET"
trap - EXIT

echo "done"
