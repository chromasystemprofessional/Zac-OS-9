#!/bin/sh

. /usr/lib/live/config.sh

## ZacOS 9: log the live user straight into the ZacOS 9
## session at boot (greetd's initial_session, once per boot); logging
## out shows the greeter. Boot with "noautologin" to start at the
## greeter instead.

Cmdline ()
{
	for _PARAMETER in ${LIVE_CONFIG_CMDLINE}
	do
		case "${_PARAMETER}" in
			live-config.username=*|username=*)
				LIVE_USERNAME="${_PARAMETER#*username=}"
				;;

			live-config.noautologin|noautologin)
				_NOAUTOLOGIN="true"
				;;
		esac
	done
}

Init ()
{
	if ! pkg_is_installed "greetd" || \
	   component_was_executed "zacos9-greetd"
	then
		exit 0
	fi

	echo -n " zacos9-greetd"
}

Config ()
{
	if [ "${_NOAUTOLOGIN:-}" != "true" ] && ! grep -q "^\[initial_session\]" /etc/greetd/config.toml
	then
		cat >> /etc/greetd/config.toml << EOF

[initial_session]
command = "zacos9-session"
user = "${LIVE_USERNAME}"
EOF
	fi

	# Creating state file
	touch /var/lib/live/config/zacos9-greetd
}

Cmdline
Init
Config
