#!/bin/sh
# Boot to the ZacOS 9 login (greetd) rather than a text console,
# silently: the boot splash, then the desktop.
set -e
systemctl enable greetd.service zacos9-console-colors.service
systemctl set-default graphical.target
# greetd takes tty1 (the splash's console) instead of a text login.
systemctl mask getty@tty1.service
# File sharing starts off; the File Sharing control panel turns it on.
systemctl disable netatalk.service smbd.service nmbd.service wsdd2.service 2>/dev/null || true
# The splash theme and settings into the initramfs.
update-initramfs -u
# The applications the system comes with (desktop file IDs: path under
# applications/ with / as -). The Finder's Applications folder shows only
# what is installed later (shell/finder/appdb.cpp).
mkdir -p /usr/share/zacos9
find /usr/share/applications /usr/local/share/applications -name '*.desktop' 2>/dev/null |
	sed -e 's|^/usr/local/share/applications/||' -e 's|^/usr/share/applications/||' -e 's|/|-|g' |
	sort -u > /usr/share/zacos9/base-applications
