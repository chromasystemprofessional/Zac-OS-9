 {
 	D(bug("EmulOp %04x at %08x\n", selector, pc));
@@ -498,6 +789,10 @@ void EmulOp(M68kRegisters *r, uint32 pc, int selector)
 			r->d[0] = (uint32)-2;
 			break;
 
+		case OP_CLASSIC_BRIDGE:
+			r->d[0] = ClassicBridgeOp(r->a[0]);
+			break;
+
 		default:
 			printf("FATAL: EMUL_OP called with bogus selector %08x\n", selector);
 			QuitEmulator();
