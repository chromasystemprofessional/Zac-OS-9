#!/bin/sh
# zacos9-session: a ZacOS 9 desktop session. Login managers run
# this from the "ZacOS 9" entry in /usr/share/wayland-sessions;
# from a text console, just type zacos9-session.
#
# Arguments go to zacos9-wm. Its messages go to
# ~/.local/state/zacos9/session.log (the previous session's to
# session.log.old).
set -u

export XDG_CURRENT_DESKTOP=ZacOS9
export XDG_SESSION_DESKTOP=zacos9
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

# Windows get ZacOS 9's frames, from the compositor, not the application's
# own: GTK 3 draws its own title bar unless told otherwise, and Qt its own
# frame if the compositor can't give it one. (GTK 4 and Electron apps that
# draw their own title bars ignore these.)
export GTK_CSD=0
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# GTK 3 applications wear the Platinum theme (share/themes/ZacOS9).
export GTK_THEME=ZacOS9
# Qt applications get the Platinum controls from the zacos9 style plugin
# (shell/qtstyle); a system without it falls back to Qt's own look.
export QT_STYLE_OVERRIDE=zacos9

# No real GPU (a plain framebuffer, or a virtual machine's display, where
# GL would be emulated on the CPU and shows stale frames): draw with
# pixman. ZacOS 9 is light enough for it.
if [ -z "${WLR_RENDERER:-}" ]; then
	gpu=false
	for node in /sys/class/drm/renderD*; do
		[ -e "$node/device/driver" ] || continue
		case $(basename "$(readlink -f "$node/device/driver")") in
		virtio_gpu | virtio-pci | bochs* | qxl | cirrus* | vboxvideo | vmwgfx | simpledrm) ;;
		*) gpu=true ;;
		esac
	done
	$gpu || export WLR_RENDERER=pixman
fi

# Apps want a D-Bus session bus. A systemd login has one in the runtime
# folder; elsewhere, start one for the session.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
	if [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
		export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
	elif command -v dbus-run-session >/dev/null; then
		exec dbus-run-session -- "$0" "$@"
	fi
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/zacos9"
mkdir -p "$state"
[ -f "$state/session.log" ] && mv -f "$state/session.log" "$state/session.log.old"

# Once the compositor is up, tell D-Bus and systemd where it is, so
# apps they start (portals, notifications) can find the display.
if [ $# -eq 0 ] && command -v dbus-update-activation-environment >/dev/null; then
	set -- -s "dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY \
XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORM GTK_CSD GTK_THEME QT_STYLE_OVERRIDE XCURSOR_THEME XCURSOR_PATH XCURSOR_SIZE"
fi
exec zacos9-wm "$@" >"$state/session.log" 2>&1
