#!/bin/sh
# zacos9-session: a ZacOS 9 desktop session. Login managers run
# this from the "ZacOS 9" entry in /usr/share/wayland-sessions;
# from a text console, just type zacos9-session.
#
# Arguments go to zacos9-wm. Its messages go to
# ~/.local/state/zacos9/session.log (the previous session's to
# session.log.old).
set -u

export XDG_CURRENT_DESKTOP=ZacOS9
export XDG_SESSION_DESKTOP=zacos9
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1

# Windows get ZacOS 9's frames, from the compositor, not the application's
# own: GTK 3 draws its own title bar unless told otherwise, and Qt its own
# frame if the compositor can't give it one. (GTK 4 and Electron apps that
# draw their own title bars ignore these.)
export GTK_CSD=0
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# GTK 3 applications wear the Platinum theme (share/themes/ZacOS9).
export GTK_THEME=ZacOS9
# Leave toolkit file dialogs on their native implementations by default.
# Explicit portal callers use the system GTK file chooser backend.
case ":${GTK_MODULES:-}:" in
	*:zacos9-appmenu:*) ;;
	*) export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}zacos9-appmenu" ;;
esac
export UBUNTU_MENUPROXY=1
# Qt applications get the Platinum controls from the zacos9 style plugin
# (shell/qtstyle); a system without it falls back to Qt's own look.
export QT_STYLE_OVERRIDE=zacos9
# ZacOS 9's defaults for other programs (share/xdg: Terminal's ⌘C/⌘V),
# ahead of the system's; a user's own ~/.config files still win.
export XDG_CONFIG_DIRS="/usr/share/zacos9/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

if ! zacos9-desktop-places; then
	echo "zacos9-session: Desktop save-location registration failed; see the error above." >&2
fi

# No real GPU (a plain framebuffer, or a virtual machine's display, where
# GL would be emulated on the CPU and shows stale frames): draw with
# pixman. ZacOS 9 is light enough for it.
# Nor on the older Radeons the radeon driver runs (HD 2000-6000, such as a
# 2007 iMac's HD 2600): their 3D engine locks up under zacos9-wm's GL
# drawing ("GPU lockup", "CP stalled", then a frozen screen), so they
# only show what pixman draws. amdgpu's newer cards are unaffected.
if [ -z "${WLR_RENDERER:-}" ]; then
	gpu=false
	for node in /sys/class/drm/renderD*; do
		[ -e "$node/device/driver" ] || continue
		case $(basename "$(readlink -f "$node/device/driver")") in
		virtio_gpu | virtio-pci | bochs* | qxl | cirrus* | vboxvideo | vmwgfx | simpledrm | radeon) ;;
		*) gpu=true ;;
		esac
	done
	$gpu || export WLR_RENDERER=pixman
fi

# Apps want a D-Bus session bus. A systemd login has one in the runtime
# folder; elsewhere, start one for the session.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
	if [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
		export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
	elif command -v dbus-run-session >/dev/null; then
		exec dbus-run-session -- "$0" "$@"
	fi
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/zacos9"
mkdir -p "$state"
[ -f "$state/session.log" ] && mv -f "$state/session.log" "$state/session.log.old"

# Once the compositor is up, tell D-Bus and systemd where it is, so
# apps they start (portals, notifications) can find the display.
startup=
if command -v dbus-update-activation-environment >/dev/null; then
	startup="dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY \
XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_CONFIG_DIRS XDG_DATA_DIRS QT_QPA_PLATFORM QT_USE_PORTAL \
GTK_USE_PORTAL GTK_CSD GTK_THEME GTK_MODULES UBUNTU_MENUPROXY QT_STYLE_OVERRIDE XCURSOR_THEME XCURSOR_PATH XCURSOR_SIZE"
fi
# The compositor runs its startup command after starting the Wayland backend,
# setting WAYLAND_DISPLAY, and launching the desktop surfaces. Import the
# session environment first, then process the effective FreeDesktop entries.
startup="${startup:+$startup; }zacos9-autostart"
# Then the password prompt for programs that need an administrator
# (polkit: balenaEtcher writing a disk, pkexec), as Mac OS asked for one.
# ZacOS 9's own helpers don't ask (their polkit rules).
if command -v lxqt-policykit-agent >/dev/null; then
	startup="${startup:+$startup; }lxqt-policykit-agent"
fi
set -- "$@" -s "$startup"
exec zacos9-wm "$@" >"$state/session.log" 2>&1
